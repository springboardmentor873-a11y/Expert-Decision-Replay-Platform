# ========================================================
# Expert Decision Replay Platform - Environment Variables
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Frontend Settings)
# --------------------------------------------------------
# Set this to your deployed FastAPI backend URL:
VITE_API_URL=https://expert-decision-replay-4b9m.vercel.app

# --------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Vercel Backend Settings)
# --------------------------------------------------------
APP_NAME="Expert Decision Replay Platform"
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Security (JWT secret key, minimum 32 random characters)
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Database (Cloud PostgreSQL: Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql+psycopg://username:password@host:5432/database_name?sslmode=require

# CORS Allowed Origins (Comma-separated list of your frontend URLs)
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Database auto-init flag (set true once on first deploy if bootstrapping cloud DB tables)
AUTO_INIT_DB=false
AUTO_SEED_DB=false
