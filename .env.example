# =============================================================================
# Expert Decision Replay Platform - Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment environment.
# DO NOT commit production secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=expert_decision_replay
POSTGRES_PORT=5432

# Database Connection URL
# For Docker Compose (service name 'postgres'):
DATABASE_URL=postgresql+psycopg2://postgres:your_secure_postgres_password_here@postgres:5432/expert_decision_replay
# For Local Development (host 'localhost'):
# DATABASE_URL=postgresql+psycopg2://postgres:your_secure_postgres_password_here@localhost:5432/expert_decision_replay

# -----------------------------------------------------------------------------
# Security & JWT Authentication
# -----------------------------------------------------------------------------
# Generate a cryptographically strong key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_long_random_secret_key_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# -----------------------------------------------------------------------------
# Application Environment & Storage
# -----------------------------------------------------------------------------
ENVIRONMENT=production
PROJECT_NAME="Expert Decision Replay Platform"
VERSION="0.1.0"
API_V1_STR="/api/v1"
UPLOAD_DIR=uploads

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
# Base URL for API calls made from the user's browser.
# For local Docker deployment where backend port 8000 is exposed to host:
VITE_API_BASE_URL=http://localhost:8000
