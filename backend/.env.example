# ==========================================
# EDRP Backend Environment Variables Template
# Copy this to .env for local development.
# Configure these in Vercel Project Settings for production.
# ==========================================

APP_NAME="Expert Decision Replay Platform"

# Environment: "development" locally, "production" on Vercel
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# Security (Required: minimum 32 random characters in production)
# Generate via: openssl rand -hex 32
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# Local SQLite default:
DATABASE_URL=sqlite:///./edrp.db
# Production PostgreSQL (Neon, Supabase, Railway, etc.):
# DATABASE_URL=postgresql+psycopg://username:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require

# CORS Allowed Origins (Comma-separated list of allowed frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional regex to match Vercel preview deployments:
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Database auto-init on startup (true in local dev, set true on first production boot if bootstrapping)
AUTO_INIT_DB=false
AUTO_SEED_DB=false
