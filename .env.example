# ============================================================
# Expert Decision Replay Platform - environment template
# Copy to `.env` next to docker-compose.yml and adjust as needed.
# ============================================================

# ---------- Ports ----------
FRONTEND_PORT=5173
BACKEND_PORT=8000
POSTGRES_PORT=5432

# ---------- PostgreSQL ----------
# Change POSTGRES_PASSWORD before exposing this stack to a network.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=decision_platform

# ---------- Backend ----------
# 25 MB in bytes. Must stay >= the frontend upload limit.
MAX_UPLOAD_BYTES=26214400

# How long startup waits for PostgreSQL to accept connections.
DB_WAIT_TIMEOUT=90

# Comma separated origins allowed to call the API directly.
# The Docker SPA is proxied through nginx, so this only matters for
# `npm run dev` in the Frontend folder.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Session signing (REQUIRED) ----------
# Identity is a signed bearer token, so this secret is what makes a session
# trustworthy. Generate one per deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# With APP_ENV=production the API refuses to start if this is missing or
# shorter than 32 characters.
JWT_SECRET=
JWT_TTL_MINUTES=480

# development | production. "production" also fails startup on a weak secret.
APP_ENV=development

# ---------- First manager (REQUIRED) ----------
# Self-service signup always creates an employee, so a deployment needs one
# operator-provisioned manager. The account is created on first boot when it
# does not exist, or promoted to manager if it already exists.
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_PASSWORD=
BOOTSTRAP_MANAGER_NAME=Platform Administrator

# Leave false everywhere except local demos that need to create a manager
# through the signup form.
ALLOW_ROLE_ESCALATION_ON_REGISTER=false

# ---------- Demo accounts ----------
# Optional convenience data: a manager and two employees for exploring the
# approval workflow. Do not enable in production.
SEED_DEMO_USERS=false
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=Manager@123
SEED_EMPLOYEE_EMAIL=employee@example.com
SEED_EMPLOYEE_PASSWORD=Employee@123
SEED_EMPLOYEE2_EMAIL=employee2@example.com
SEED_EMPLOYEE2_PASSWORD=Employee@123

# ---------- Frontend ----------
# Only needed outside Docker. Inside Docker nginx serves the app and
# reverse-proxies /api, so this stays /api.
# VITE_API_BASE_URL=http://127.0.0.1:8000